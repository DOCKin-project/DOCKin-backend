# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋되지 않는다.
#
#   cp .env.example .env
#
# [여기에 무엇을 두는가]
# 비밀값과 머신마다 다른 값만 둔다. 팀 공통 설정은 application.properties에 있어야 한다.
# 예전에는 이 파일 계열에 로깅 정책이 들어 있었고, 커밋되지 않는 탓에 사람마다 로그가
# 다르게 보였다. com.DOCKin이 warn으로 잠겨 기동 완료 로그와 색인 진행 로그가
# 통째로 사라진 적이 있다(이슈 #30). 환경변수는 properties를 덮으므로 여기 적은 것이 이긴다.

# Database
# compose로 띄우면 DB_HOST는 서비스 이름(DOCKin-DB)이고, 호스트에서 직접 붙으면 localhost다.
# DB_USERNAME/PASSWORD는 PostgreSQL 컨테이너를 처음 만들 때 그대로 계정이 된다
# (compose.yaml의 POSTGRES_USER/POSTGRES_PASSWORD가 이 값을 받는다).
DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JWT
# JWT_SECRET은 HS256 서명 키다. 길이가 짧으면 기동 시점에 실패한다.
# EXPIRATION 계열은 밀리초다.
JWT_SECRET=
JWT_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# S3 (파일 업로드)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# 팀원 FastAPI (번역 / STT)
# RAG 임베딩 서버(EMBEDDING_SERVER_URL)와는 별개다. 그쪽은 compose가 직접 준다.
AI_SERVER_URL=
